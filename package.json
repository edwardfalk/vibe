{
  "name": "vibe-game",
  "version": "2.0.0",
  "description": "Browser space shooter where every enemy is an instrument — the soundtrack is the fight",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "npx five-server --port=5500",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:headed": "playwright test --project=e2e --headed",
    "test:e2e:debug": "playwright test --project=e2e --debug",
    "test:unit": "npx vitest run",
    "test:unit:watch": "npx vitest",
    "test:coverage": "npx vitest run --coverage",
    "lint": "npx eslint \"**/*.js\"",
    "format": "npx prettier --write \"**/*.{js,md,json}\"",
    "screenshot": "playwright test --project=screenshot",
    "screenshot:level": "LEVEL=${LEVEL:-3} playwright test --project=screenshot",
    "test:beats": "playwright test --project=beats",
    "playtest": "playwright test --project=playtest",
    "compare": "node tests/replay/compare.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "eslint": "^9.28.0",
    "eslint-plugin-prettier": "^5.0.1",
    "five-server": "^0.4.4",
    "prettier": "^3.5.3",
    "@vitest/coverage-v8": "^3.2.2",
    "vitest": "^3.2.2"
  },
  "keywords": [
    "game",
    "p5js",
    "javascript",
    "space-shooter",
    "procedural-graphics",
    "geometric-art"
  ],
  "author": "Edward Falk",
  "license": "MIT"
}
