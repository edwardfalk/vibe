{
  "name": "vibe-game",
  "version": "2.0.0",
  "description": "A p5.js geometric space shooter survival game with procedural graphics",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "serve": "npx five-server --port=5500",
    "predev": "npx kill-port 5500",
    "dev": "pnpm run serve",
    "test": "npx playwright test && pnpm run test:unit",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:debug": "npx playwright test --debug",
    "test:unit": "npx vitest run",
    "test:unit:watch": "npx vitest",
    "test:coverage": "npx vitest run --coverage",
    "lint": "npx eslint \"**/*.js\"",
    "format": "npx prettier --write \"**/*.{js,md,json}\"",
    "clean": "rm -rf node_modules",
    "fresh": "pnpm run clean && pnpm install",
    "screenshot": "npx playwright test tests/screenshot.js --config=playwright.screenshot.config.js --reporter=list",
    "screenshot:level": "LEVEL=${LEVEL:-3} npx playwright test tests/screenshot.js --config=playwright.screenshot.config.js --reporter=list",
    "test:beats": "npx playwright test tests/beat-assertions.js --config=playwright.beat-assertions.config.js --reporter=list",
    "playtest": "npx playwright test tests/playtest.js --config=playwright.playtest.config.js --reporter=list",
    "prepare": "git config core.hooksPath .githooks"
  },
  "bun": {
    "dev": {
      "port": 5500,
      "hot": true,
      "watch": [
        "js/**/*.js",
        "index.html",
        "*.css"
      ]
    },
    "test": {}
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "five-server": "^0.4.4",
    "prettier": "^3.5.3",
    "@vitest/coverage-v8": "^3.2.2",
    "vitest": "^3.2.2"
  },
  "keywords": [
    "game",
    "p5js",
    "javascript",
    "space-shooter",
    "procedural-graphics",
    "geometric-art"
  ],
  "author": "Vibe Game Developer",
  "license": "MIT"
}
