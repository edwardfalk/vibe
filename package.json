{
  "name": "vibe-game",
  "version": "2.0.0",
  "description": "A p5.js geometric space shooter survival game with procedural graphics",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "serve": "bunx five-server --port=5500",
    "predev": "bunx kill-port 5500",
    "dev": "bun run serve",
    "test": "bunx playwright test && bun run test:unit",
    "test:e2e": "bunx playwright test",
    "test:e2e:headed": "bunx playwright test --headed",
    "test:e2e:debug": "bunx playwright test --debug",
    "test:unit": "bunx vitest run",
    "test:unit:watch": "bunx vitest",
    "lint": "bunx eslint \"**/*.js\"",
    "format": "bunx prettier --write \"**/*.{js,md,json}\"",
    "clean": "rm -rf node_modules bun.lockb",
    "fresh": "bun run clean && bun install"
  },
  "bun": {
    "dev": {
      "port": 5500,
      "hot": true,
      "watch": [
        "js/**/*.js",
        "index.html",
        "*.css"
      ]
    },
    "test": {}
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "five-server": "^0.4.4",
    "prettier": "^3.5.3",
    "vitest": "^3.2.2"
  },
  "keywords": [
    "game",
    "p5js",
    "javascript",
    "space-shooter",
    "procedural-graphics",
    "geometric-art"
  ],
  "author": "Vibe Game Developer",
  "license": "MIT"
}
